// Modelo de dados da loja Belart.
// Depois de alterar este arquivo, rode: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Catálogo ----------

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  description    String
  price          Decimal         @db.Decimal(10, 2)
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  available      Boolean         @default(true)
  featured       Boolean         @default(false) // aparece em "Destaques" na página inicial
  bestseller     Boolean         @default(false) // aparece em "Mais vendidos"
  productionTime String? // texto livre, ex.: "3 a 5 dias úteis"
  images         ProductImage[]
  options        ProductOption[]
  customizations Customization[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)

  @@index([productId])
}

// Variação escolhida pelo cliente (ex.: "Cor", "Tamanho", "Capacidade").
// Só aparecem na loja as variações cadastradas para cada produto.
model ProductOption {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int           @default(0)
  values    OptionValue[]

  @@index([productId])
}

model OptionValue {
  id         String        @id @default(cuid())
  optionId   String
  option     ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Decimal       @default(0) @db.Decimal(10, 2) // acréscimo no preço (0 = sem acréscimo)
  available  Boolean       @default(true)
  sortOrder  Int           @default(0)

  @@index([optionId])
}

enum CustomizationType {
  TEXT // texto curto (nome, frase)
  LONG_TEXT // descrição da arte, observações
  SELECT // escolha entre opções fixas
  IMAGE_LINK // link para a arte/foto do cliente
}

// Campo de personalização preenchido pelo cliente (ex.: "Nome a gravar").
model Customization {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  type       CustomizationType @default(TEXT)
  required   Boolean           @default(false)
  maxLength  Int?
  choices    String[]
  priceDelta Decimal           @default(0) @db.Decimal(10, 2)
  sortOrder  Int               @default(0)

  @@index([productId])
}

// ---------- Pedidos ----------

enum FulfillmentType {
  UBER_DELIVERY
  PICKUP
}

enum OrderStatus {
  RECEIVED // pedido registrado, aguardando contato
  CONFIRMED // combinado com o cliente
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELED
}

model Order {
  id            String          @id @default(cuid())
  code          String          @unique // código curto mostrado ao cliente
  customerName  String
  phone         String
  fulfillment   FulfillmentType
  address       String? // obrigatório quando a entrega é por Uber
  notes         String?
  status        OrderStatus     @default(RECEIVED)
  subtotal      Decimal         @db.Decimal(10, 2)
  total         Decimal         @db.Decimal(10, 2)
  privacyAccept Boolean // consentimento LGPD
  items         OrderItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Cópia dos dados do produto no momento da compra (preço e nome não mudam
// no pedido se o produto for editado depois).
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  unitPrice      Decimal  @db.Decimal(10, 2)
  quantity       Int
  options        Json // [{ name, value }]
  customizations Json // [{ label, value }]

  @@index([orderId])
}

// ---------- Administração e conteúdo ----------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

// Depoimentos reais cadastrados pelo painel (a seção só aparece se houver algum).
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  text      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Informações da loja editáveis pelo painel (e-mail, retirada, regra do Uber, horário...).
model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
