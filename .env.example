# Copie este arquivo para ".env" e preencha os valores.
# O ".env" está no .gitignore e nunca vai para o GitHub.

# --- Banco de dados (Supabase → Project Settings → Database → Connection string) ---
# Conexão pelo pooler (porta 6543), usada pelo site:
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão direta (porta 5432), usada só para criar/alterar tabelas (migrations):
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Endereço público do site (sem barra no final) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase Storage (imagens dos produtos — usado a partir da etapa 3) ---
NEXT_PUBLIC_SUPABASE_URL=""

# --- Chave para renovar o cache do catálogo (qualquer texto longo e aleatório) ---
# Usada pelo importador (npm run catalogo:importar) para as mudanças aparecerem na hora.
REVALIDATE_SECRET=""
